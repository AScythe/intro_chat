// Description: Plugin and MCP server configuration for OpenCode — enables ast-grep structural search/replace and cocoindex-code semantic search tools
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-ast-grep"],
  "mcp": {
    "cocoindex-code": {
      "type": "local",
      "command": ["ccc", "mcp"]
    },
    "graphify": {
      "type": "local",
      "command": ["python", "-m", "graphify.serve", "graphify-out/graph.json"]
    }
  }
}
